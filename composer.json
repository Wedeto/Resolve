{
    "name": "wedeto/resolve",
    "license": "MIT",
    "description": "Wedeto Platform - Autoloader, template, asset and app resolver",
    "homepage": "https://wedeto.net/",
    "require": {
        "wedeto/util": "^1.1.1",
        "php": "^7.4 || >=8.1"
    },
    "require-dev": {
